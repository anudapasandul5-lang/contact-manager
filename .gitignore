# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local archive / generated workspace history
/_archive
../_archive/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.worktrees/
.planning/
.superpowers/
docs/superpowers/

# env files (can opt-in for committing if needed)
.env*
.env.test.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dev scripts and one-off tooling (not app code)
*.csv
*.mjs
*.cjs
test_supabase.js
signup-*.txt
output/
*.log

# local tooling
.claude/
.playwright-cli/
.logs/
.vercel/
